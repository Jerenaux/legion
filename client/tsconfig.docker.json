{
  "compilerOptions": {
    "lib": ["dom"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "react": ["./node_modules/preact/compat"],
      "react-dom": ["./node_modules/preact/compat"],
      "@legion/shared/*": ["shared/*"],
      "@assets/*": ["./public/*"]
    },
    "sourceMap": true
  },
  "include": ["src/**/*", "types/**/*"]
}
