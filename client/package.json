{
  "name": "client",
  "version": "0.1.2",
  "description": "Legion desktop game client",
  "author": "Dynetis Games",
  "private": true,
  "scripts": {
    "start": "webpack serve --open",
    "build": "NODE_ENV=production webpack --mode production",
    "test": "bun test",
    "electron:dev": "concurrently \"bun run start\" \"electron electron.js\"",
    "electron:build": "BUILD_TARGET=electron bun run build && electron-builder --mac --win",
    "electron:build:mac": "BUILD_TARGET=electron bun run build && electron-builder --mac",
    "electron:build:win": "BUILD_TARGET=electron bun run build && electron-builder --win",
    "electron:build:linux": "BUILD_TARGET=electron bun run build && electron-builder --linux",
    "electron:test": "BUILD_TARGET=electron bun run build && electron-builder --dir",
    "release:validate": "../tools/validate_desktop_release.sh"
  },
  "license": "ISC",
  "dependencies": {
    "@react-hook/window-size": "^3.1.1",
    "@sentry/react": "^8.55.2",
    "@sentry/webpack-plugin": "^5.4.0",
    "@types/react-tooltip": "^4.2.4",
    "copy-webpack-plugin": "^14.0.0",
    "firebase": "^12.18.0",
    "logrocket": "^9.0.2",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.20",
    "preact": "10.19.3",
    "preact-router": "^4.1.2",
    "react-confetti": "^6.4.0",
    "react-countup": "^6.5.3",
    "react-loading-skeleton": "^3.5.0",
    "react-modal": "^3.16.3",
    "react-progressbar-fancy": "^1.1.4",
    "shepherd.js": "^15.3.0",
    "socket.io-client": "^4.8.3",
    "steamworks.js": "^0.4.0",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/bun": "latest",
    "@types/react-modal": "^3.16.3",
    "@types/webpack-env": "1.18.8",
    "babel-loader": "^9.2.1",
    "concurrently": "^8.2.2",
    "css-loader": "^6.11.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5",
    "webpack": "^5.110.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "overrides": {
    "i18next-http-backend": "^4.0.2",
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.legion.game",
    "productName": "Legion",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron.js",
      "preload.js",
      "electron/**/*",
      "!electron/**/__tests__/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/steamworks.js",
        "to": "steamworks.js",
        "filter": ["index.js", "package.json", "LICENSE", "dist/**/*"]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron.js"
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "public/logo.png",
      "hardenedRuntime": true,
      "notarize": true,
      "x64ArchFiles": "Contents/Resources/steamworks.js/dist/osx/**"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/logo.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo.png",
      "executableName": "Legion"
    }
  }
}
