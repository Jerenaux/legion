{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "lib": ["es2022"],
    "baseUrl": "./",
		"paths": {
            "obscenity": ["./node_modules/obscenity"],
			"@legion/shared/*": ["shared/*"],
			"@legion/locales/*": ["locales/*"]
		},
    "skipLibCheck": true,
  },
  "compileOnSave": true,
  "include": [
    "src"
  ],
  "exclude": [
    "src/__tests__"
  ]
}
